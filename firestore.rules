rules_version = '2';

// The browser never writes to Firestore. All changes go through the Netlify Function
// (netlify/functions/api.mjs), which uses the Firebase Admin SDK and bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // The raffle record is public so pages can listen for changes instead of polling.
    // It holds raffle settings and claimed spot numbers, but no names, emails, or payment details.
    match /givingboard_raffles/{raffleId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (requests, history, admins) stays closed to browsers.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
