rules_version = '2';

// The browser never reads or writes Firestore directly. All data goes through the
// Netlify Function (netlify/functions/api.mjs), which uses the Firebase Admin SDK and
// bypasses these rules. Deny all client access so nothing can read raffle or payment data
// from the public web.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
