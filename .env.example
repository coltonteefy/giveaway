SESSION_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Netlify + Firebase deployment ---
# Set these as Netlify site environment variables (Site settings > Environment variables),
# and as a local shell var when running scripts/seed-firestore.mjs.
# FIREBASE_SERVICE_ACCOUNT = the full service account JSON (Firebase console > Project settings
# > Service accounts > Generate new private key), either pasted as raw JSON or base64-encoded.
FIREBASE_SERVICE_ACCOUNT=

# Organizer login is Firebase Authentication (email/password). Who can sign in and which
# raffle(s) they manage is stored in Firestore (collection "givingboard_admins"), not here.
# Bootstrap your own "super" (full access, can add/remove other organizers) account once:
#   npm run seed:super-admin -- you@example.com
# Then add other organizers from the dashboard's "Manage organizers" panel, or via:
#   npm run add:organizer -- someone@example.com <raffleId>
